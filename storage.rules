rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email in [
          'suchita9867@gmail.com',
          'wpwebpole@gmail.com',
          'vk725846@gmail.com'
        ] &&
        request.auth.token.email_verified == true;
    }

    // Customer private documents (Aadhaar, Scooty photos, Battery photo)
    match /customers/{customerUid}/applications/{applicationId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == customerUid || isBootstrappedAdmin());
      allow write: if isSignedIn() &&
        request.auth.uid == customerUid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Customer payment proofs
    match /customers/{customerUid}/payments/{paymentId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == customerUid || isBootstrappedAdmin());
      allow write: if isSignedIn() &&
        request.auth.uid == customerUid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Issued policies (Admin write only, customer + admin read)
    match /customers/{customerUid}/policies/{policyId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == customerUid || isBootstrappedAdmin());
      allow write: if isBootstrappedAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }
  }
}
